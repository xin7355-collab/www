/**
 * Cloudflare 部署設定。
 *
 * 只有走 Workers（Workers Builds / `wrangler deploy`）那條路時才會用到；
 * 若走 Cloudflare Pages 流程，設定在儀表板上填，這個檔案會被忽略。
 *
 * `run_worker_first` 是密碼閘門能不能成立的關鍵 —— 沒有它，靜態檔案會先於
 * Worker 被送出，閘門就只擋得到「沒有對應檔案的路徑」，JS bundle（內含
 * NEXT_PUBLIC_APPS_SCRIPT_URL）等於沒鎖。
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    // next build 的 static export 產出目錄
    "directory": "./out",
    // 讓 worker/index.js 能把請求轉給靜態資源
    "binding": "ASSETS",
    // out/404.html 是 Next 產生的 not-found 頁
    "not_found_handling": "404-page",
    // 先跑 Worker（密碼閘門），再送靜態檔
    "run_worker_first": true
  }
}
